{
  "name": "r108",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rデータ分析 108ステップ — ブラウザで学ぶR独習アプリ",
  "author": "安藤至大（日本大学経済学部）",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:r && vite",
    "build": "npm run validate && npm run build:r && tsc -b && vite build",
    "build:r": "node scripts/build-r.mjs",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:r": "Rscript -e 'testthat::test_local(\"r/r108check\")' && Rscript tests/r/run_solutions.R",
    "test:e2e": "playwright test",
    "test:local": "Rscript tests/r/test_local.R"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/markdown-it": "^14.2.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "webr": "^0.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
